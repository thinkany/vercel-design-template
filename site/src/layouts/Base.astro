---
// ©2026 thinkany llc. All rights reserved.
// The site's HTML shell: SEO head (title, description, canonical, Open Graph,
// robots) resolved from the entry's SEO fields with site-level fallbacks, then
// the chrome (Header/Footer from site/blocks/chrome.ts, when the designer
// registered them; imported by NAME so the header can hydrate) around the page. The `@container` wrapper is what the design's `@lg:` container
// variants measure against, exactly as DesignSurface provides in the design
// surface, so promoted blocks keep their responsive classes unchanged.
import "@design/fonts.css";  // the design's webfonts and tokens: their own stylesheets, so their
import "@design/tokens.css"; // Google Fonts @import stays at the top where browsers honor it (see site.css)
import "../styles/site.css";
import { siteConfig } from "@/config/site";
import { resolveNav } from "../lib/nav";
import { resolveLogos } from "../lib/logos";
import { jsonLdText, type LdPage } from "../lib/schema";
import { resolveSeo, type Seo } from "../lib/seo";
import { site } from "../lib/site";
import { Header, Footer, chrome } from "../../blocks/chrome";

interface Props {
  title: string;
  description?: string;
  seo?: Partial<Seo>;
  /** A draft previews locally (the Site tab) with a Draft pill; it never builds, so the pill never reaches a published site. */
  draft?: boolean;
}
const { title, description, seo, ld, ldBlocks, draft } = Astro.props as { title: string; description?: string; seo?: Record<string, unknown>; draft?: boolean; ld?: LdPage; ldBlocks?: Record<string, unknown>[] };
const siteName = site.seo.siteName || siteConfig.clientName;
const meta = resolveSeo(seo, { title, description, siteName, separator: site.seo.separator });
const canonical = meta.canonical || new URL(Astro.url.pathname, Astro.site).href;
const shareImage = meta.image || site.seo.image; // the page's own, else the site image
const image = shareImage ? new URL(shareImage, Astro.site).href : undefined;

const logos = resolveLogos(site.logos, siteConfig.logo || undefined, site.seo.siteName || siteConfig.clientName);
const chromeProps = { siteName: siteConfig.clientName, logo: logos.header, logos, nav: await resolveNav(site), footerLinks: site.footerLinks, legal: site.legal };
// Self-hosted fonts (site/src/lib/self-host-fonts.mjs writes public/fonts at build and
// defines __TA_FONT_PRELOAD__): the local sheet + preloads for the display and body
// faces. Not hosted (offline build): preconnect to Google instead.
declare const __TA_FONT_PRELOAD__: string[] | null;
const fontPreload: string[] | null = typeof __TA_FONT_PRELOAD__ !== "undefined" ? __TA_FONT_PRELOAD__ : null;
const fontsHosted = Array.isArray(fontPreload);
// Scripts (Settings → Scripts) go in ONLY when the build runs on Vercel, i.e. the
// published site: never local dev, the local build check, or the design previews.
const injectScripts = import.meta.env.VERCEL === "1" || process.env.VERCEL === "1";
const gtmRaw = (site.scripts.gtm || "").trim();
const gtmId = /^GTM-[A-Z0-9]+$/i.test(gtmRaw) ? gtmRaw.toUpperCase() : null;
const gtmHead = !injectScripts ? "" : gtmId
  ? `<!-- Google Tag Manager --><script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');</script><!-- End Google Tag Manager -->`
  : gtmRaw;
const gtmBody = injectScripts && gtmId ? `<!-- Google Tag Manager (noscript) --><noscript><iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript><!-- End Google Tag Manager (noscript) -->` : "";
const extra = (where: "head" | "bodyStart" | "bodyEnd") => (injectScripts ? site.scripts.extra.filter((s) => s.placement === where && s.code.trim()).map((s) => s.code).join("\n") : "");
// Structured data: one JSON-LD graph, generated (site/src/lib/schema.ts) + the page's custom block.
const ldText = jsonLdText({
  siteUrl: Astro.site ? Astro.site.href.replace(/\/$/, "") : "",
  siteName, logo: siteConfig.logo || undefined, schema: site.seo.schema,
  url: canonical, title: (seo && (seo as { title?: string }).title) || title, description: meta.description, image,
  page: ld || { kind: "page" }, blocks: ldBlocks || [], custom: seo ? (seo as { jsonld?: string }).jsonld : undefined,
});
// Site icons from content/site.json (the CMS Settings tab); the scaffold's favicon.svg otherwise.
const favicon = site.favicon.icon || "/favicon.svg";
const faviconType = /\.svg$/i.test(favicon) ? "image/svg+xml" : /\.png$/i.test(favicon) ? "image/png" : /\.ico$/i.test(favicon) ? "image/x-icon" : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {(fontPreload || []).map((f) => <link rel="preload" as="font" type="font/woff2" href={f} crossorigin />)}
    {fontsHosted ? <link rel="stylesheet" href="/fonts/fonts.css" /> : <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {!fontsHosted && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    <title>{meta.title}</title>
    {meta.description && <meta name="description" content={meta.description} />}
    <link rel="canonical" href={canonical} />
    {(meta.noindex || site.seo.discourage) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={meta.title} />
    {meta.description && <meta property="og:description" content={meta.description} />}
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {meta.keyphrase && <meta name="keywords" content={meta.keyphrase} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={meta.title} />
    {meta.description && <meta name="twitter:description" content={meta.description} />}
    {image && <meta name="twitter:image" content={image} />}
    <link rel="icon" type={faviconType} href={favicon} />
    {site.favicon.touch && <link rel="apple-touch-icon" sizes="180x180" href={site.favicon.touch} />}
    {site.seo.sitemap && !site.seo.discourage && <link rel="sitemap" href="/sitemap-index.xml" />}
    <!-- Marks JS as available BEFORE first paint, so data-reveal elements only
         start hidden when the observer below will actually reveal them. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
      <script type="application/ld+json" set:html={ldText} />
    <Fragment set:html={gtmHead} />
    <Fragment set:html={extra("head")} />
  </head>
  <body class="bg-ta-surface text-ta-body font-ta-sans">
    <Fragment set:html={gtmBody} />
    <Fragment set:html={extra("bodyStart")} />
    <div class="@container relative flex min-h-screen w-full flex-col">
      {Header && (chrome.header?.hydrate ? <Header client:load {...chromeProps} /> : <Header {...chromeProps} />)}
      <main class="flex-1">
        <slot />
      </main>
      {Footer && (chrome.footer?.hydrate ? <Footer client:load {...chromeProps} /> : <Footer {...chromeProps} />)}
      {import.meta.env.DEV && draft && <div class="fixed bottom-4 left-4 z-[60] rounded-full bg-ta-ink px-3 py-1 font-ta-sans text-[11px] tracking-[0.12em] uppercase text-ta-surface shadow-md" title="A draft: previewed here, left out of the published site">Draft</div>}
    </div>
    <script>
      // Parallax in browsers without CSS scroll-driven animations (Firefox): the same
      // module the design surface loads; a no-op where the CSS runs.
      import "@/app/parallax-fallback";
      // Scroll reveal: pairs with .js [data-reveal] in site.css. Once, at 30%
      // visibility, matching the design surface's motion whileInView settings.
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-revealed");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.3 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-revealed"));
      }
    </script>
    <script>
      // Forms (site/src/lib/form-client.ts): JSON submit + the thank-you state for
      // every form[data-ta-form] on the page. Without JS the form posts natively.
      import { enhanceForms } from "../lib/form-client";
      enhanceForms(document);
    </script>
    <Fragment set:html={extra("bodyEnd")} />
  </body>
</html>
