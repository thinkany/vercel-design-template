---
// ©2026 thinkany llc. All rights reserved.
// TYPE INDEX → /<path>, for every content type that declares one. Pages win: a page
// at the same address keeps it, and the index simply isn't generated. (The posts
// index lives in [...slug].astro, since the posts directory may sit under a page.)
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { typesFile } from "../../lib/types";
import { pageRoute } from "../../lib/pages";
import rawTypes from "../../../../content/types.json";

export async function getStaticPaths() {
  const { types } = typesFile.parse(rawTypes);
  const pages = await getCollection("pages");
  const taken = new Set(pages.map((p) => "/" + pageRoute(p, pages)));
  const out: { params: { type: string }; props: Record<string, unknown> }[] = types
    .filter((t) => t.index && !t.dataOnly && !taken.has(t.path))
    .map((t) => ({ params: { type: t.path.replace(/^\//, "") }, props: { type: t } }));
  return out;
}

const { type } = Astro.props;
const entries = (await getCollection(type.key as never, (({ data }: { data: { draft?: boolean } }) => import.meta.env.DEV || !data.draft) as never)) as { id: string; data: Record<string, unknown> & { title: string; slug?: string; seo?: { description?: string; noindex?: boolean } } }[];
entries.sort((a, b) => a.data.title.localeCompare(b.data.title));
const imageField = type.fields.find((f) => f.kind === "image");
const summaryField = type.fields.find((f) => f.kind === "textarea" || f.kind === "text");
const href = (e: (typeof entries)[number]) => `${type.path}/${e.data.slug ?? e.id}`;
---
  <Base title={type.index?.title || type.label} description={type.index?.description} ld={{ kind: "collection" }}>
    <main class="mx-auto max-w-[1160px] px-6 py-20">
      <h1 class="font-ta-display text-[clamp(32px,5vw,48px)] text-ta-ink leading-[1.05] tracking-[-0.02em] mb-4">{type.index?.title || type.label}</h1>
      {type.index?.description && <p class="font-ta-serif text-[17px] text-ta-body leading-[1.6] max-w-[60ch] mb-12">{type.index.description}</p>}
      <ul class="list-none p-0 m-0 grid gap-8 @lg:grid-cols-3">
        {entries.map((e) => {
          const img = imageField ? (e.data[imageField.key] as { src: string; alt?: string } | undefined) : undefined;
          const summary = summaryField ? (e.data[summaryField.key] as string | undefined) : undefined;
          return (
            <li>
              <a href={href(e)} class="no-underline block">
                {img?.src && <img src={img.src} alt={img.alt || ""} class="w-full aspect-[4/3] object-cover rounded-[3px] mb-4" />}
                <h2 class="font-ta-display text-[22px] text-ta-ink leading-[1.15] mb-2">{e.data.title}{import.meta.env.DEV && (e.data as { draft?: boolean }).draft && <span class="ml-3 align-middle rounded-full bg-ta-ink px-2 py-[2px] font-ta-sans text-[10px] tracking-[0.12em] uppercase text-ta-surface">Draft</span>}</h2>
                {summary && <p class="font-ta-sans text-[15px] text-ta-body leading-[1.6] m-0">{summary}</p>}
              </a>
            </li>
          );
        })}
      </ul>
    </main>
  </Base>
