---
// ©2026 thinkany llc. All rights reserved.
// SECTION INDEX → /<path>. Two kinds share this route (one segment, so they can't
// collide): the POSTS index at the configured posts directory (content/site.json
// blog.path, "blog" by default), and a TYPE index for every content type that
// declares one. Pages win: a page at the same address keeps it, and the index
// simply isn't generated (the CMS refuses that clash for the posts directory).
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { typesFile } from "../../lib/types";
import { pageRoute } from "../../lib/pages";
import { blogPath } from "../../lib/site";
import rawTypes from "../../../../content/types.json";

export async function getStaticPaths() {
  const { types } = typesFile.parse(rawTypes);
  const pages = await getCollection("pages");
  const taken = new Set(pages.map((p) => "/" + pageRoute(p, pages)));
  const out: { params: { type: string }; props: Record<string, unknown> }[] = types
    .filter((t) => t.index && !taken.has(t.path))
    .map((t) => ({ params: { type: t.path.replace(/^\//, "") }, props: { type: t } }));
  if (!taken.has("/" + blogPath) && !types.some((t) => t.path.replace(/^\//, "") === blogPath)) out.push({ params: { type: blogPath }, props: { blog: true } });
  return out;
}

const { type, blog } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const posts = blog ? (await getCollection("posts", ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()) : [];
const entries = (blog ? [] : await getCollection(type.key as never)) as { id: string; data: Record<string, unknown> & { title: string; slug?: string; seo?: { description?: string; noindex?: boolean } } }[];
entries.sort((a, b) => a.data.title.localeCompare(b.data.title));
const imageField = blog ? undefined : type.fields.find((f) => f.kind === "image");
const summaryField = blog ? undefined : type.fields.find((f) => f.kind === "textarea" || f.kind === "text");
const href = (e: (typeof entries)[number]) => `${type.path}/${e.data.slug ?? e.id}`;
---
{blog ? (
  <Base title="Blog" description="Latest posts">
    <main class="max-w-[720px] mx-auto px-6 py-20">
      <h1 class="font-ta-display text-[clamp(32px,5vw,48px)] text-ta-ink leading-[1.05] tracking-[-0.02em] mb-12">Blog</h1>
      <ul class="list-none p-0 m-0 flex flex-col gap-10">
        {posts.map((p) => (
          <li>
            <a href={`/${blogPath}/${p.id}`} class="no-underline">
              <div class="font-ta-sans text-[11px] tracking-[0.14em] uppercase text-ta-muted mb-2">{fmt(p.data.date)}</div>
              <h2 class="font-ta-display text-[26px] text-ta-ink leading-[1.15] mb-2">{p.data.title}</h2>
              {p.data.description && <p class="font-ta-serif text-[16px] text-ta-body leading-[1.6] m-0">{p.data.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    </main>
  </Base>
) : (
  <Base title={type.index?.title || type.label} description={type.index?.description}>
    <main class="mx-auto max-w-[1160px] px-6 py-20">
      <h1 class="font-ta-display text-[clamp(32px,5vw,48px)] text-ta-ink leading-[1.05] tracking-[-0.02em] mb-4">{type.index?.title || type.label}</h1>
      {type.index?.description && <p class="font-ta-serif text-[17px] text-ta-body leading-[1.6] max-w-[60ch] mb-12">{type.index.description}</p>}
      <ul class="list-none p-0 m-0 grid gap-8 @lg:grid-cols-3">
        {entries.map((e) => {
          const img = imageField ? (e.data[imageField.key] as { src: string; alt?: string } | undefined) : undefined;
          const summary = summaryField ? (e.data[summaryField.key] as string | undefined) : undefined;
          return (
            <li>
              <a href={href(e)} class="no-underline block">
                {img?.src && <img src={img.src} alt={img.alt || ""} class="w-full aspect-[4/3] object-cover rounded-[3px] mb-4" />}
                <h2 class="font-ta-display text-[22px] text-ta-ink leading-[1.15] mb-2">{e.data.title}</h2>
                {summary && <p class="font-ta-sans text-[15px] text-ta-body leading-[1.6] m-0">{summary}</p>}
              </a>
            </li>
          );
        })}
      </ul>
    </main>
  </Base>
)}
