// TYPE ENTRY → /<path>/<slug>, rendered through its type's template (blocks with
// {{field}} bindings), or its own `blocks` when it carries them (a landing page).
// richtext fields are markdown, rendered to HTML (site/src/lib/richtext) for a
// binding whose target prop name ends in Html. (Posts live in [...slug].astro,
// since the posts directory may sit under a page.)
import { getCollection } from "astro:content";
import { renderMarkdown } from "../../lib/richtext";
import Base from "../../layouts/Base.astro";
import { resolveBlock } from "../../lib/blocks";
import { bindTemplate, typesFile } from "../../lib/types";
import { blocks } from "../../../blocks";
import { withBuiltins } from "../../lib/builtin-blocks";
import rawTypes from "../../../../content/types.json";

export async function getStaticPaths() {
  const { types } = typesFile.parse(rawTypes);
  const out: { params: { type: string; slug: string }; props: Record<string, unknown> }[] = [];
  for (const t of types) {
    if (t.dataOnly) continue; // data only: no page per entry
    const entries = await getCollection(t.key as never, (({ data }: { data: { draft?: boolean } }) => import.meta.env.DEV || !data.draft) as never);
    for (const e of entries as { id: string; data: { slug?: string } }[]) {
      out.push({ params: { type: t.path.replace(/^\//, ""), slug: e.data.slug ?? e.id }, props: { type: t, entry: e } });
    }
  }
  return out;
}

const { type, entry } = Astro.props;

// A type entry: template + bindings (richtext → also `<key>Html`).
const data = (entry ? entry.data : {}) as Record<string, unknown> & { title: string; seo?: Record<string, unknown>; blocks?: { type: string; props: Record<string, unknown> }[] };
// richtext → also `<key>Html`, through the site's own renderer (no extra package).
const bound: Record<string, unknown> = { ...data };
for (const f of type.fields) {
  if (f.kind === "richtext" && typeof data[f.key] === "string") bound[f.key + "Html"] = renderMarkdown(data[f.key] as string);
}
const instances = data.blocks && data.blocks.length ? data.blocks : bindTemplate(type.template, bound);
const rendered = instances.map((b, i) => resolveBlock(withBuiltins(blocks), b, `content/${type.key}/${entry.id}.json blocks[${i}]`));
---
  <Base title={data.title} draft={data.draft} seo={data.seo} ldBlocks={rendered.flatMap((r) => r.schema || [])}>
    {rendered.map(({ component: Block, props }) => <Block {...props} />)}
  </Base>
