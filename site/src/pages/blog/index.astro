---
// ©2026 thinkany llc. All rights reserved.
// Blog index: every non-draft post, newest first.
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---
<Base title="Blog" description="Latest posts">
  <main class="max-w-[720px] mx-auto px-6 py-20">
    <h1 class="font-ta-display text-[clamp(32px,5vw,48px)] text-ta-ink leading-[1.05] tracking-[-0.02em] mb-12">Blog</h1>
    <ul class="list-none p-0 m-0 flex flex-col gap-10">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}`} class="no-underline">
            <div class="font-ta-sans text-[11px] tracking-[0.14em] uppercase text-ta-muted mb-2">{fmt(p.data.date)}</div>
            <h2 class="font-ta-display text-[26px] text-ta-ink leading-[1.15] mb-2">{p.data.title}</h2>
            {p.data.description && <p class="font-ta-serif text-[16px] text-ta-body leading-[1.6] m-0">{p.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
