---
// ©2026 thinkany llc. All rights reserved.
// PAGES → routes. Every entry in content/pages becomes a route at its slug
// (home.json → "/", about.json → "/about"). The page is its ordered list of
// block instances, each validated + rendered from the designer's registry.
//
// Page blocks render to STATIC HTML. Astro resolves a `client:*` directive
// against this file's own imports, so a block reached through the registry
// can't hydrate; interactive page blocks are a later phase (a generated
// per-block wrapper). Until then a block that sets `hydrate` fails the build
// here, loudly, instead of shipping without its behaviour.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { resolveBlock } from "../lib/blocks";
import { pageRoute } from "../lib/pages";
import { blocks } from "../../blocks";
import { withBuiltins } from "../lib/builtin-blocks";

export async function getStaticPaths() {
  // Drafts are previewed in dev and never built for the published site.
  const pages = await getCollection("pages", ({ data }) => import.meta.env.DEV || !data.draft);
  return pages.map((page) => {
    const slug = pageRoute(page, pages); // parent chain: "about/island-guide"
    // Breadcrumbs: Home, then each ancestor, then this page.
    const chain: typeof pages = []; let cur: (typeof pages)[number] | undefined = page; let g = 0;
    while (cur && cur.id !== "home" && g++ < 16) { chain.unshift(cur); cur = cur.data.parent ? pages.find((p) => p.id === cur!.data.parent) : undefined; }
    const home = pages.find((p) => p.id === "home");
    const crumbs = [...(home ? [{ name: home.data.title, route: "" }] : []), ...chain.map((p) => ({ name: p.data.title, route: pageRoute(p, pages) }))];
    return { params: { slug: slug || undefined }, props: { page, crumbs } };
  });
}

const { page, crumbs } = Astro.props;
const site = Astro.site ? Astro.site.href.replace(/\/$/, "") : "";
const ld = { kind: "page" as const, crumbs: page.id === "home" ? [] : (crumbs as { name: string; route: string }[]).map((c) => ({ name: c.name, url: site + "/" + c.route })) };
const rendered = page.data.blocks.map((b, i) => {
  const where = `content/pages/${page.id}.json blocks[${i}]`;
  const r = resolveBlock(withBuiltins(blocks), b, where);
  if (r.hydrate) {
    throw new Error(`${where}: block "${b.type}" sets hydrate: "${r.hydrate}", but page blocks render static HTML for now (only the chrome in site/blocks/chrome.ts hydrates). Move the interactive part to CSS, or drop hydrate.`);
  }
  return r;
});
---
<Base title={page.data.title} seo={page.data.seo} ld={ld} ldBlocks={rendered.flatMap((r) => r.schema || [])}>
  {rendered.map(({ component: Block, props }) => <Block {...props} />)}
</Base>
