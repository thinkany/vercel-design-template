// ©2026 thinkany llc. All rights reserved.
// PAGES → routes. Every entry in content/pages becomes a route at its slug
// (home.json → "/", about.json → "/about"). The page is its ordered list of
// block instances, each validated + rendered from the designer's registry.
//
// Page blocks render to STATIC HTML. Astro resolves a `client:*` directive
// against this file's own imports, so a block reached through the registry
// can't hydrate; interactive page blocks are a later phase (a generated
// per-block wrapper). Until then a block that sets `hydrate` fails the build
// here, loudly, instead of shipping without its behaviour.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import BlogIndex from "../components/BlogIndex.astro";
import BlogPost from "../components/BlogPost.astro";
import { resolveBlock } from "../lib/blocks";
import { pageRoute } from "../lib/pages";
import { blogPath, blogParent } from "../lib/site";
import { blocks } from "../../blocks";
import { withBuiltins } from "../lib/builtin-blocks";

// The BLOG lives here too: its index at the posts directory (Settings → Blog) and a
// page per post under it. The directory may sit under a parent page (/resources/blog),
// which is why it is this rest route and not a fixed-depth one. A page at the same
// address keeps it (the CMS refuses that clash for the directory itself).
export async function getStaticPaths() {
  // Drafts are previewed in dev and never built for the published site.
  const pages = await getCollection("pages", ({ data }) => import.meta.env.DEV || !data.draft);
  const crumbsFor = (parentId: string | undefined) => {
    const chain: typeof pages = []; let cur = parentId ? pages.find((p) => p.id === parentId) : undefined; let g = 0;
    while (cur && cur.id !== "home" && g++ < 16) { chain.unshift(cur); cur = cur.data.parent ? pages.find((p) => p.id === cur!.data.parent) : undefined; }
    const home = pages.find((p) => p.id === "home");
    return [...(home ? [{ name: home.data.title, route: "" }] : []), ...chain.map((p) => ({ name: p.data.title, route: pageRoute(p, pages) }))];
  };
  const out: { params: { slug: string | undefined }; props: Record<string, unknown> }[] = [];
  const taken = new Set(pages.map((p) => pageRoute(p, pages)));
  if (!taken.has(blogPath)) {
    const posts = (await getCollection("posts", ({ data }) => import.meta.env.DEV || !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    const blogCrumbs = [...crumbsFor(blogParent || undefined), { name: "Blog", route: blogPath }];
    out.push({ params: { slug: blogPath }, props: { blog: true, posts, crumbs: blogCrumbs } });
    for (const post of posts) out.push({ params: { slug: `${blogPath}/${post.data.slug || post.id}` }, props: { post, crumbs: blogCrumbs } });
  }
  return [...out, ...pages.map((page) => {
    const slug = pageRoute(page, pages); // parent chain: "about/island-guide"
    // Breadcrumbs: Home, then each ancestor, then this page.
    const chain: typeof pages = []; let cur: (typeof pages)[number] | undefined = page; let g = 0;
    while (cur && cur.id !== "home" && g++ < 16) { chain.unshift(cur); cur = cur.data.parent ? pages.find((p) => p.id === cur!.data.parent) : undefined; }
    const home = pages.find((p) => p.id === "home");
    const crumbs = [...(home ? [{ name: home.data.title, route: "" }] : []), ...chain.map((p) => ({ name: p.data.title, route: pageRoute(p, pages) }))];
    return { params: { slug: slug || undefined }, props: { page, crumbs } };
  })];
}

const { page, crumbs, blog, posts, post } = Astro.props;
const site = Astro.site ? Astro.site.href.replace(/\/$/, "") : "";
const crumbUrls = (crumbs as { name: string; route: string }[]).map((c) => ({ name: c.name, url: site + "/" + c.route }));
const ld = page ? { kind: "page" as const, crumbs: page.id === "home" ? [] : crumbUrls } : null;
const rendered = !page ? [] : page.data.blocks.map((b, i) => {
  const where = `content/pages/${page.id}.json blocks[${i}]`;
  const r = resolveBlock(withBuiltins(blocks), b, where);
  if (r.hydrate) {
    throw new Error(`${where}: block "${b.type}" sets hydrate: "${r.hydrate}", but page blocks render static HTML for now (only the chrome in site/blocks/chrome.ts hydrates). Move the interactive part to CSS, or drop hydrate.`);
  }
  return r;
});
---
{blog ? (
  <BlogIndex posts={posts} crumbs={crumbUrls} />
) : post ? (
  <BlogPost post={post} />
) : (
  <Base title={page.data.title} draft={page.data.draft} seo={page.data.seo} ld={ld} ldBlocks={rendered.flatMap((r) => r.schema || [])}>
    {rendered.map(({ component: Block, props }) => <Block {...props} />)}
  </Base>
)}
