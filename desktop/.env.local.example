# Copy this file to `.env.local` (same folder) and fill in a real key.
# `.env.local` is gitignored (never committed). Get a key at platform.claude.com.
ANTHROPIC_API_KEY=sk-ant-...

# License key for the cloud derive service (Figma export). Sent as x-license-key
# to DERIVE_ENDPOINT (defaults to https://derive.thinkany.design/api/derive).
# Temporary — the app will manage the license in-app later (IP plan step 4).
DERIVE_LICENSE_KEY=
